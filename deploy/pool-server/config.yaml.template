# Generated by deploy/pool-server/bootstrap.sh. Keep this file under the CPA
# data directory so the signed license lease and installation identity survive
# container replacement. Values marked __...__ are replaced during bootstrap.
host: "0.0.0.0"
port: __CPA_PORT__

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  allow-remote: true
  secret-key: "__CPA_MANAGEMENT_KEY__"
  disable-control-panel: true
  disable-auto-update-panel: true
  panel-github-repository: "https://github.com/seakee/CPA-Manager-Plus"

# CPA storefront authorization. Publisher keys are public release metadata;
# client credentials stay in the Docker secret mounted by compose.yml.
license:
  provider: "__CPA_LICENSE_PROVIDER__"
  product-code: "__CPA_LICENSE_PRODUCT_CODE__"
  api-base-url: "__CPA_LICENSE_API_BASE_URL__"
  public-key: "__CPA_LICENSE_PUBLIC_KEY__"
  plugin-public-key: "__CPA_LICENSE_PLUGIN_PUBLIC_KEY__"
  client-id: "__CPA_LICENSE_CLIENT_ID__"
  client-secret: ""
  state-dir: "__CPA_LICENSE_STATE_DIR__"
  shop-auth-url: "__CPA_LICENSE_SHOP_AUTH_URL__"
  shop-exchange-path: "__CPA_LICENSE_SHOP_EXCHANGE_PATH__"
  activate-path: "__CPA_LICENSE_ACTIVATE_PATH__"
  refresh-path: "__CPA_LICENSE_REFRESH_PATH__"
  verify-path: "__CPA_LICENSE_VERIFY_PATH__"
  grace-path: "__CPA_LICENSE_GRACE_PATH__"
  refresh-interval: "__CPA_LICENSE_REFRESH_INTERVAL__"
  # The storefront signs the effective grace lease. This local value only
  # applies while a refresh response is temporarily unavailable.
  grace-period: "__CPA_LICENSE_GRACE_PERIOD__"
  instance-binding: "strict"
  storage-key: "__CPA_LICENSE_STORAGE_KEY__"
  executable-sha256: "__CPA_LICENSE_EXECUTABLE_SHA256__"
  claim-path: "__CPA_LICENSE_CLAIM_PATH__"

auth-dir: "/app/data/auths"

api-keys:
  - "__CPA_DEMO_API_KEY__"

debug: false
commercial-mode: false
logging-to-file: false
usage-statistics-enabled: true
redis-usage-queue-retention-seconds: 3600
proxy-url: ""
source-ip: ""
request-retry: 3
max-retry-credentials: 0
max-retry-interval: 30

routing:
  strategy: round-robin
  session-affinity: false
  high-cache-mode: true

# Keep the cache-affinity and tail-burst defaults used by the published CPA
# pool. These settings are part of the runtime contract, not installer-only
# hints, so a newly bootstrapped customer pool behaves like the verified build.
codex:
  identity-confuse: true
  cache-affinity:
    enabled: true
    shadow: false
    max-entries: 65536
    max-retry-credentials: 2
    max-concurrency: 8
    websocket-pool-slots: 8
    max-session-requests: 2000
    max-session-duration: "1h"
    quota-preempt-used-ratio: 0.97
    quota-hard-stop-used-ratio: 0.99
  tail-burst:
    enabled: false
    quota-collector:
      enabled: true
      interval: "45s"
      max-concurrency: 4
      timeout: "8s"
