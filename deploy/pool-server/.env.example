# Copy this file to .env and run ./bootstrap.sh. The bootstrap script fills
# generated keys and converts relative paths to absolute paths.
COMPOSE_PROJECT_NAME=cpamp-cpa
TZ=Asia/Shanghai

# Public release images. Keep CPA pinned to a tested release. CPAMP may use a
# semver tag or digest when you publish a matching manager release.
CPA_IMAGE=ghcr.io/abc124774961/cli-proxy-api-cpa:v7.2.148-cpa.3
CPA_PULL_POLICY=always
# Pin CPAMP too; change this only as an explicit, tested upgrade.
CPAMP_IMAGE=ghcr.io/seakee/cpa-manager-plus:v1.12.8
CPAMP_PULL_POLICY=always

# Host/listener settings. CPA uses host networking; CPAMP maps its internal
# listener to CPAMP_PORT. Agent also uses host networking.
CPA_PORT=8317
CPAMP_PORT=18317
CPAMP_INTERNAL_PORT=18317
CPAMP_AGENT_PORT=18417

# Names are configurable for an isolated customer stack. Keep the defaults if
# using CPAMP container-operations APIs that target the standard names.
CPA_CONTAINER_NAME=cli-proxy-api
CPAMP_CONTAINER_NAME=cpa-manager-plus
CPAMP_AGENT_CONTAINER_NAME=cpamp-agent
CPAMP_NETWORK_NAME=cpamp-cpa_default

# Absolute paths are recommended. bootstrap.sh resolves relative values against
# this directory and never moves an existing data directory.
CPA_DATA_DIR=./data/cpa
CPAMP_DATA_DIR=./data/manager
CPAMP_STACK_ROOT=.
CPAMP_BACKUP_ROOT=./backups
CPAMP_ADMIN_KEY_FILE=./secrets/cpamp-admin-key
CPA_MANAGEMENT_KEY_FILE=./secrets/cpa-management-key

# Generated by bootstrap.sh when left empty or set to a placeholder.
CPAMP_AGENT_TOKEN=replace-with-a-long-random-agent-token
CPA_MANAGEMENT_KEY=replace-with-cpa-management-key
CPA_MANAGER_ADMIN_KEY=replace-with-a-long-random-admin-key

# CPA storefront license settings. The public key is required to verify the
# signed license and storefront-controlled grace lease. Client credentials are
# optional and must stay in local secret files.
CPA_LICENSE_PROVIDER=shop666
CPA_LICENSE_PRODUCT_CODE=CPA
CPA_LICENSE_PUBLIC_KEY=kJhDRBpfneFdURvPXwiGW3XAmPrd2HVVORfHzP-eYTg
CPA_LICENSE_PLUGIN_PUBLIC_KEY=OHRHVVIlFC34K-5AQUkOPcZLeiSpeX_n_VPbrH3agXQ
CPA_LICENSE_CLIENT_ID=
# Legacy direct value is still accepted for existing installs. bootstrap.sh
# migrates it into CPA_LICENSE_CLIENT_SECRET_HOST_PATH and clears this field.
CPA_LICENSE_CLIENT_SECRET=
CPA_LICENSE_CLIENT_SECRET_HOST_PATH=./secrets/cpa-license-client-secret
# Legacy host-path alias accepted by bootstrap.sh:
CPA_LICENSE_CLIENT_SECRET_FILE=
CPA_LICENSE_API_BASE_URL=https://p.666ttt.net/api/storefront
CPA_LICENSE_STATE_DIR=/CLIProxyAPI/data/license
CPA_LICENSE_SHOP_AUTH_URL=https://p.666ttt.net/shop/?authorize=cpa
CPA_LICENSE_SHOP_EXCHANGE_PATH=/licenses/exchange
CPA_LICENSE_ACTIVATE_PATH=/licenses/activate
CPA_LICENSE_REFRESH_PATH=/licenses/refresh
CPA_LICENSE_VERIFY_PATH=/licenses/verify
CPA_LICENSE_GRACE_PATH=/licenses/grace
CPA_LICENSE_REFRESH_INTERVAL=10m
# This is only the local refresh-outage fallback. The storefront signs and
# controls the effective grace lease (default deployment policy: 6 hours).
CPA_LICENSE_GRACE_PERIOD=6h
CPA_LICENSE_STORAGE_KEY=
CPA_LICENSE_EXECUTABLE_SHA256=
CPA_LICENSE_CLAIM_PATH=

USAGE_CORS_ORIGINS=*
USAGE_QUOTA_COOLDOWN_ENABLED=true
